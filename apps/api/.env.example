NODE_ENV=development
PORT=4000
# Comma-separated list of browser origins allowed by CORS
WEB_ORIGIN=http://localhost:3000
# Supabase project URL (JWTs are verified against <SUPABASE_URL>/auth/v1/.well-known/jwks.json)
SUPABASE_URL=https://<project-ref>.supabase.co
# Least-privilege role morphcall_api through the transaction pooler (port 6543)
DATABASE_URL=postgresql://morphcall_api.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?sslmode=require
