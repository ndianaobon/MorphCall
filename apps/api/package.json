{
  "name": "@morphcall/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "concurrently -k -n tsc,api \"tsc -p tsconfig.build.json --watch --preserveWatchOutput\" \"node --watch --env-file-if-exists=.env dist/main.js\"",
    "start": "node --env-file-if-exists=.env dist/main.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "staff:grant": "node --env-file-if-exists=.env --experimental-strip-types scripts/grant-staff.ts"
  },
  "dependencies": {
    "@fastify/helmet": "^13.0.2",
    "@morphcall/contracts": "workspace:*",
    "@nestjs/common": "^12.0.3",
    "@nestjs/core": "^12.0.3",
    "@nestjs/platform-fastify": "^12.0.3",
    "@nestjs/platform-socket.io": "^12.0.3",
    "@nestjs/throttler": "^6.7.0",
    "@nestjs/websockets": "^12.0.3",
    "drizzle-orm": "^0.45.2",
    "fastify": "5.12.4",
    "jose": "^6.2.12",
    "livekit-server-sdk": "^2.19.0",
    "postgres": "^3.4.9",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "socket.io": "^4.8.3",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@nestjs/testing": "^12.0.3",
    "@swc/core": "^1.13.5",
    "@types/node": "^22.18.0",
    "concurrently": "^9.2.1",
    "typescript": "5.9.3",
    "unplugin-swc": "^1.5.7",
    "vitest": "^5.0.1"
  }
}
